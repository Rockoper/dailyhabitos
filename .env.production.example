# DailyHábitos — plantilla de entorno de PRODUCCIÓN (Synology + Docker Compose).
#
# Este archivo se versiona en Git y NUNCA debe contener contraseñas reales.
# En el servidor: `cp .env.production.example .env` y reemplaza cada
# CHANGE_ME_* por un valor real generado (ver docs/DEPLOYMENT_SYNOLOGY.md).
#
# Este mismo archivo lo leen dos cosas a la vez:
#   1. Docker Compose (interpola ${DB_DATABASE}, ${DB_PASSWORD}, etc. en
#      compose.yaml para configurar Postgres/Redis/el puerto de Nginx).
#   2. El contenedor de Laravel (vía `env_file: .env` en compose.yaml).
# Es la única fuente de verdad: no dupliques estas credenciales en otro sitio.

APP_NAME=DailyHábitos
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dailyhabitos.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Base de datos: PostgreSQL exclusivo de DailyHábitos -------------------
# DB_HOST debe coincidir con el nombre del servicio en compose.yaml; no lo
# cambies salvo que también renombres el servicio `dailyhabitos-postgres`.
DB_CONNECTION=pgsql
DB_HOST=dailyhabitos-postgres
DB_PORT=5432
DB_DATABASE=dailyhabitos
DB_USERNAME=dailyhabitos
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# --- Sesiones -----------------------------------------------------------
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
# La app solo se sirve por HTTPS (Cloudflare Tunnel), así que la cookie de
# sesión debe exigir HTTPS. Ver TrustProxies en bootstrap/app.php.
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=dailyhabitos_cache

# --- Redis: exclusivo de DailyHábitos -------------------------------------
# REDIS_HOST debe coincidir con el servicio `dailyhabitos-redis` de compose.yaml.
REDIS_CLIENT=phpredis
REDIS_HOST=dailyhabitos-redis
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

# --- Correo (opcional; deja `log` si todavía no tienes SMTP configurado) --
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@dailyhabitos.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Solo Docker Compose (no los lee Laravel) -----------------------------
# Puerto local en el Synology para pruebas internas antes de conectar
# Cloudflare Tunnel, p. ej. http://192.168.1.31:8180.
NGINX_PORT=8180
